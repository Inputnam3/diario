JWT_EXPIRES_IN=1d

# Configurações do Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=seu_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # Número do Twilio Sandbox
