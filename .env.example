# Configurações do Ngrok (para desenvolvimento)
NGROK_AUTH_TOKEN=seu_ngrok_auth_token  # Opcional, mas recomendado para sessões estáveis

# Configurações de Log
LOG_LEVEL=debug  # Pode ser 'error', 'warn', 'info', 'debug', 'silly'

# Configurações de CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Configurações de Cache (opcional)
REDIS_URL=redis://localhost:6379  # Opcional, para cache distribuído

# Configurações de E-mail (para notificações, opcional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false  # true para porta 465, false para outras portas
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha
SMTP_FROM="Natuzap <contato@natuzap.com.br>"
