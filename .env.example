DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=natuzap

# Configurações do Supabase (obrigatório para produção)
# Obtenha a URL de conexão do painel do Supabase em Database > Connection String
# Formato: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=

